<Project>

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup Label="Repository engine">
    <PackageVersion Include="System.Formats.Cbor" Version="10.0.10" />
    <PackageVersion Include="Microsoft.Data.Sqlite" Version="10.0.10" />
    <PackageVersion Include="ZstdSharp.Port" Version="0.8.8" />
  </ItemGroup>

  <ItemGroup Label="CLI">
    <PackageVersion Include="System.CommandLine" Version="2.0.0-beta7.25380.108" />
  </ItemGroup>

  <ItemGroup Label="Testing">
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.0.0" />
    <PackageVersion Include="coverlet.collector" Version="6.0.4" />
    <PackageVersion Include="FsCheck.Xunit" Version="3.3.4" />
    <PackageVersion Include="NetArchTest.Rules" Version="1.3.2" />
    <PackageVersion Include="BenchmarkDotNet" Version="0.15.8" />
    <!-- Test-only. Retained as an independent Argon2id implementation to
         cross-verify Bodu's, per Argon2idCrossVerificationTests. Never shipped. -->
    <PackageVersion Include="Konscious.Security.Cryptography.Argon2" Version="1.3.1" />
  </ItemGroup>

  <!-- Transitive pins.

       SQLitePCLRaw 2.1.11 arrives transitively via Microsoft.Data.Sqlite and
       carries GHSA-2m69-gcr7-jv3q (high). Warnings-as-errors caught it at
       restore, which is NFR-SUP-002 behaving as intended. Pinned forward to a
       fixed version rather than suppressed.

       These entries mirror what the resolved graph ACTUALLY contains — verify
       with `dotnet list package` (include transitives) after changing any of
       them. An earlier revision pinned SQLitePCLRaw.lib.e_sqlite3, a package
       the 3.x bundle no longer pulls at all: an inert pin that looked like a
       security control. The native library now arrives as the package named
       `SQLite`, and the config/core/provider trio at the bundle's version. -->
  <ItemGroup Label="Transitive pins">
    <PackageVersion Include="Microsoft.Data.Sqlite.Core" Version="10.0.10" />
    <PackageVersion Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.5" />
    <PackageVersion Include="SQLitePCLRaw.config.e_sqlite3" Version="3.0.5" />
    <PackageVersion Include="SQLitePCLRaw.core" Version="3.0.5" />
    <PackageVersion Include="SQLitePCLRaw.provider.e_sqlite3" Version="3.0.5" />
    <PackageVersion Include="SQLite" Version="3.53.4" />
  </ItemGroup>

</Project>
