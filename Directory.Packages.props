<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <ItemGroup Label="Repository engine">
    <PackageVersion Include="System.Formats.Cbor" Version="10.0.10" />
    <PackageVersion Include="Microsoft.Data.Sqlite" Version="10.0.10" />
    <PackageVersion Include="ZstdSharp.Port" Version="0.8.8" />
    <!-- Prebuilt Bodu packages from the committed external/packages feed —
         not published to nuget.org. Provenance and upgrade procedure:
         external/packages/README.md, ADR-0021. -->
    <PackageVersion Include="Bodu.Core" Version="0.2.0" />
    <PackageVersion Include="Bodu.Security.Cryptography" Version="0.2.0" />
    <PackageVersion Include="Bodu.Text.Encoding" Version="0.2.0" />
    <PackageVersion Include="Bodu.Globalization.Recurrence" Version="0.2.0" />
    <!-- The diagnostics ring buffer (ADR-0043 §6): a lock-free Vyukov MPMC
         ConcurrentCircularBuffer<T> with drop-oldest eviction, which is the
         data structure the client log feed needs and one this repository has
         no business writing itself. Operational tier (ADR-0019 §2): reached
         only by FallbackPlan.Diagnostics, which the Agent and CLI reference —
         never Repository.Format, so never the recovery tool's closure. MIT.
         Bodu.Collections is its declared dependency, not a direct use. -->
    <PackageVersion Include="Bodu.Collections.Concurrent" Version="0.2.0" />
    <PackageVersion Include="Bodu.Collections" Version="0.2.0" />
  </ItemGroup>
  <ItemGroup Label="Logging">
    <!-- The abstraction only, in every shipped assembly: ILogger, NullLogger and
         the [LoggerMessage] source generator. Managed-only and first-party, so it
         clears ADR-0019's format-critical bar for Repository.Format's closure —
         which is the standalone recovery tool's closure (ADR-0043 §1).

         The concrete factory and level filtering are pinned to
         FallbackPlan.Diagnostics by a project-file canary in DependencyRuleTests.
         No provider, exporter or third-party sink package enters the tree: where
         the bytes land is the host's business, exactly as ADR-0027 §3 decided for
         metrics. -->
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.10" />
    <PackageVersion Include="Microsoft.Extensions.Logging" Version="10.0.10" />
  </ItemGroup>
  <ItemGroup Label="CLI">
    <PackageVersion Include="System.CommandLine" Version="2.0.10" />
  </ItemGroup>
  <ItemGroup Label="Agent service host">
    <!-- ServiceBase, for the Windows SCM Start/Stop handshake (ADR-0033). The
         implementation is Windows-only; the reference assembly is cross-platform
         so the Linux and macOS builds compile, and every call is guarded by
         OperatingSystem.IsWindows(). -->
    <PackageVersion Include="System.ServiceProcess.ServiceController" Version="10.0.10" />
  </ItemGroup>
  <ItemGroup Label="Testing">
    <PackageVersion Include="MSTest" Version="3.11.0" />
    <!-- FsCheck's property runner ships xUnit and NUnit integrations and no
         MSTest one, so the [Property] tests drive FsCheck's framework-agnostic
         Check API from an ordinary [TestMethod] instead (ADR-0032). The
         package is still the source of the generators and shrinkers. -->
    <PackageVersion Include="FsCheck" Version="3.3.4" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.8.1" />
    <PackageVersion Include="Microsoft.Playwright" Version="1.62.0" />
    <PackageVersion Include="coverlet.collector" Version="10.0.1" />
    <PackageVersion Include="NetArchTest.Rules" Version="1.3.2" />
    <PackageVersion Include="BenchmarkDotNet" Version="0.15.8" />
    <!-- Test-only. Retained as an independent Argon2id implementation to
         cross-verify Bodu's, per Argon2idCrossVerificationTests. Never shipped. -->
    <PackageVersion Include="Konscious.Security.Cryptography.Argon2" Version="1.3.1" />
  </ItemGroup>
  <!-- Transitive pins.

       SQLitePCLRaw 2.1.11 arrives transitively via Microsoft.Data.Sqlite and
       carries GHSA-2m69-gcr7-jv3q (high). Warnings-as-errors caught it at
       restore, which is NFR-SUP-002 behaving as intended. Pinned forward to a
       fixed version rather than suppressed.

       These entries mirror what the resolved graph ACTUALLY contains — verify
       with `dotnet list package` (include transitives) after changing any of
       them. An earlier revision pinned SQLitePCLRaw.lib.e_sqlite3, a package
       the 3.x bundle no longer pulls at all: an inert pin that looked like a
       security control. The native library now arrives as the package named
       `SQLite`, and the config/core/provider trio at the bundle's version. -->
  <ItemGroup Label="Transitive pins">
    <PackageVersion Include="Microsoft.Data.Sqlite.Core" Version="10.0.10" />
    <PackageVersion Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.5" />
    <PackageVersion Include="SQLitePCLRaw.config.e_sqlite3" Version="3.0.5" />
    <PackageVersion Include="SQLitePCLRaw.core" Version="3.0.5" />
    <PackageVersion Include="SQLitePCLRaw.provider.e_sqlite3" Version="3.0.5" />
    <PackageVersion Include="SQLite" Version="3.53.4" />
  </ItemGroup>
</Project>