<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="FsCheck" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="NetArchTest.Rules" />
    <PackageReference Include="MSTest" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Microsoft.VisualStudio.TestTools.UnitTesting" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\FallbackPlan.Domain\FallbackPlan.Domain.csproj" />
    <ProjectReference Include="..\..\src\FallbackPlan.Repository\FallbackPlan.Repository.csproj" />
    <ProjectReference Include="..\..\src\FallbackPlan.Repository.Format\FallbackPlan.Repository.Format.csproj" />
    <ProjectReference Include="..\..\src\FallbackPlan.Repository.Crypto\FallbackPlan.Repository.Crypto.csproj" />
    <ProjectReference Include="..\..\src\FallbackPlan.Repository.Segmentation\FallbackPlan.Repository.Segmentation.csproj" />
    <ProjectReference Include="..\..\src\FallbackPlan.Repository.Packing\FallbackPlan.Repository.Packing.csproj" />
    <ProjectReference Include="..\..\src\FallbackPlan.Repository.Index\FallbackPlan.Repository.Index.csproj" />
    <ProjectReference Include="..\..\src\FallbackPlan.Repository.Catalogue\FallbackPlan.Repository.Catalogue.csproj" />
    <ProjectReference Include="..\..\src\FallbackPlan.Filesystem\FallbackPlan.Filesystem.csproj" />
    <ProjectReference Include="..\..\src\FallbackPlan.Filesystem.Local\FallbackPlan.Filesystem.Local.csproj" />
    <ProjectReference Include="..\..\src\FallbackPlan.Storage.Abstractions\FallbackPlan.Storage.Abstractions.csproj" />
    <ProjectReference Include="..\..\src\FallbackPlan.Storage.Local\FallbackPlan.Storage.Local.csproj" />
    <ProjectReference Include="..\..\src\FallbackPlan.Import.Abstractions\FallbackPlan.Import.Abstractions.csproj" />
    <ProjectReference Include="..\..\src\FallbackPlan.Diagnostics\FallbackPlan.Diagnostics.csproj" />
    <ProjectReference Include="..\..\src\FallbackPlan.Replication\FallbackPlan.Replication.csproj" />
    <ProjectReference Include="..\..\src\FallbackPlan.Retention\FallbackPlan.Retention.csproj" />
    <!-- Referenced so the containment rules can inspect every src assembly,
         including the executable. Cli has no AssemblyMarker; it is loaded by
         name from the test output directory. -->
    <ProjectReference Include="..\..\src\FallbackPlan.Cli\FallbackPlan.Cli.csproj" />
    <ProjectReference Include="..\..\src\FallbackPlan.Protocol\FallbackPlan.Protocol.csproj" />
    <ProjectReference Include="..\..\src\FallbackPlan.Recovery\FallbackPlan.Recovery.csproj" />
    <ProjectReference Include="..\..\src\FallbackPlan.Agent\FallbackPlan.Agent.csproj" />
    <ProjectReference Include="..\..\src\FallbackPlan.Web\FallbackPlan.Web.csproj" />
    <ProjectReference Include="..\..\src\FallbackPlan.Restore\FallbackPlan.Restore.csproj" />
    <ProjectReference Include="..\..\src\FallbackPlan.Api\FallbackPlan.Api.csproj" />
    <ProjectReference Include="..\..\src\FallbackPlan.Application\FallbackPlan.Application.csproj" />
    <!-- Diagnostics, Replication and Retention have no AssemblyMarker, so they
         are loaded by name like the executables. They are referenced here so
         they reach the test output directory: without these lines the
         containment rules cannot see them, which is how they stayed outside
         AllSourceAssemblies. -->
    <ProjectReference Include="..\..\src\FallbackPlan.Diagnostics\FallbackPlan.Diagnostics.csproj" />
    <ProjectReference Include="..\..\src\FallbackPlan.Replication\FallbackPlan.Replication.csproj" />
    <ProjectReference Include="..\..\src\FallbackPlan.Retention\FallbackPlan.Retention.csproj" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FallbackPlan.TestSupport\FallbackPlan.TestSupport.csproj" />
  </ItemGroup>

</Project>