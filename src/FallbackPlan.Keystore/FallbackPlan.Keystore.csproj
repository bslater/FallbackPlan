<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Required by the source-generated LibraryImport marshalling used for
         DPAPI and Keychain Services. Warnings are errors here, and DllImport
         would raise one, so this is the honest option rather than the quiet
         one. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <!-- One project with platform guards inside, following Filesystem.Local:
       the three keystores answer the same question and differ only in which
       operating system is answering, so splitting them into per-OS projects
       would spread one decision across three build graphs. No project
       reference: this knows nothing about repositories. -->

  <ItemGroup>
    <!-- Prebuilt package from the committed external/packages feed: parameter
         validation (ADR-0019 section 4 / ADR-0021). Guard clauses are one
         vocabulary across the solution rather than per-project taste. -->
    <PackageReference Include="Bodu.Core" />
  </ItemGroup>

</Project>
