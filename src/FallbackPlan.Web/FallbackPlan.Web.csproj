<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <!-- The client contract, and nothing below it: a front end that could
         reach the engine would be a second writer (11 §2, ADR-0036).
         ArchitectureTests holds this list to exactly one entry. -->
    <ProjectReference Include="..\FallbackPlan.Api\FallbackPlan.Api.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Kestrel and the minimal hosting surface, from the in-box shared
         framework — first-party, so ADR-0019's third-party surface grows by
         nothing (ADR-0036 §5). -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <!-- Prebuilt package from the committed external/packages feed: parameter
         validation (ADR-0019 section 4 / ADR-0021). -->
    <PackageReference Include="Bodu.Core" />
  </ItemGroup>

  <ItemGroup>
    <!-- The page, self-contained in the assembly: no CDN, no package manager,
         nothing fetched at runtime (ADR-0036 §5). -->
    <EmbeddedResource Include="wwwroot\index.html" LogicalName="wwwroot/index.html" />
    <EmbeddedResource Include="wwwroot\app.css" LogicalName="wwwroot/app.css" />
    <EmbeddedResource Include="wwwroot\app.js" LogicalName="wwwroot/app.js" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
