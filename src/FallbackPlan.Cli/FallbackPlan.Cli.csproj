<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\FallbackPlan.Diagnostics\FallbackPlan.Diagnostics.csproj" />
    <ProjectReference Include="..\FallbackPlan.Api\FallbackPlan.Api.csproj" />
    <ProjectReference Include="..\FallbackPlan.Application\FallbackPlan.Application.csproj" />
    <ProjectReference Include="..\FallbackPlan.Protocol\FallbackPlan.Protocol.csproj" />
    <ProjectReference Include="..\FallbackPlan.Repository\FallbackPlan.Repository.csproj" />
    <ProjectReference Include="..\FallbackPlan.Filesystem.Local\FallbackPlan.Filesystem.Local.csproj" />
    <ProjectReference Include="..\FallbackPlan.Repository.Catalogue\FallbackPlan.Repository.Catalogue.csproj" />
    <ProjectReference Include="..\FallbackPlan.Repository.Index\FallbackPlan.Repository.Index.csproj" />
    <ProjectReference Include="..\FallbackPlan.Restore\FallbackPlan.Restore.csproj" />
    <ProjectReference Include="..\FallbackPlan.Storage.Local\FallbackPlan.Storage.Local.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.CommandLine" />
    <!-- Prebuilt package from the committed external/packages feed: parameter
         validation (ADR-0019 section 4 / ADR-0021). Guard clauses are one
         vocabulary across the solution rather than per-project taste. -->
    <PackageReference Include="Bodu.Core" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!-- The gateway's job-await loop is internal and its Paused behavior is a
       stated promise (ADR-0047 Amendment 1: a suspended run resumes
       unattended, so a waiting `backup` keeps waiting) — pinned by a unit
       test over a fake client rather than a live preempted service. -->
  <ItemGroup>
    <InternalsVisibleTo Include="FallbackPlan.Cli.Tests" />
  </ItemGroup>

  <!-- The logging abstraction only: ILogger, NullLogger and the
       [LoggerMessage] source generator. Providers and sinks are the host's,
       and a canary in DependencyRuleTests keeps them there (ADR-0043). -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>
  <!-- The runtime guard for a defect that has bitten this repository twice
       and cost a day to diagnose the first time (ADR-0043, and the .slnx
       exclusions removed in a577c24).

       The concrete Microsoft.Extensions.Logging reaches this executable ONLY
       through its ProjectReference to FallbackPlan.Diagnostics — ADR-0043 §1
       pins the package there and nowhere else, and a canary in
       DependencyRuleTests keeps it that way. The compiler cannot see when that
       flow breaks, because the abstraction it compiles against is a different
       package: this project builds perfectly and throws FileNotFoundException
       on the first line it tries to log.

       Two different faults produce that one symptom, and they have opposite
       remedies, so the guard tells them apart rather than guessing.
       @(ReferenceCopyLocalPaths) is what ResolveReferences decided should be
       copied; comparing it against what is actually in $(TargetDir) separates
       "the graph never offered it" from "the copy did not happen". Naming the
       wrong cause would be worse than naming none — it sends the next person
       hunting somewhere already clean. -->
  <Target Name="AssertLoggingProviderWasCopied" AfterTargets="Build"
          Condition="'$(OutputType)' == 'Exe'">

    <ItemGroup>
      <_LoggingProviderResolved Include="@(ReferenceCopyLocalPaths)"
                                Condition="'%(Filename)%(Extension)' == 'Microsoft.Extensions.Logging.dll'" />
    </ItemGroup>

    <!-- Never resolved: the dependency graph this build used does not contain
         the package at all. -->
    <Error Condition="'@(_LoggingProviderResolved)' == ''"
           Text="Microsoft.Extensions.Logging was not resolved for this project, so the built executable would throw FileNotFoundException the first time it logs. It arrives only through the ProjectReference to FallbackPlan.Diagnostics (ADR-0043 §1), and the dependency graph this build used does not contain it. Most often the restore inputs are stale: delete bin and obj under this project and under src/FallbackPlan.Diagnostics, run `dotnet restore`, and build again. If that does not fix it, check FallbackPlan.slnx for a &lt;Build&gt; element with Project=&quot;false&quot; excluding FallbackPlan.Diagnostics from this configuration (`python3 eng/check-solution.py` reports these), and delete the .vs folder if an IDE is caching an older solution model." />

    <!-- Resolved and still absent: resolution was right and the file did not
         arrive, which is a filesystem problem rather than a build one. -->
    <Error Condition="'@(_LoggingProviderResolved)' != '' And !Exists('$(TargetDir)Microsoft.Extensions.Logging.dll')"
           Text="Microsoft.Extensions.Logging.dll was resolved for this project but is not in $(TargetDir), so the built executable would throw FileNotFoundException the first time it logs. The dependency graph is correct and the copy is what failed, so this is not a project or solution problem. Something is holding or hiding the destination: a folder-sync client (OneDrive, Dropbox) syncing bin and obj — exclude them, because a dehydrated placeholder lists like a file and cannot be read — an antivirus scanner holding the write, or a fallbackplan-agent process still running from the last build." />
  </Target>

</Project>
