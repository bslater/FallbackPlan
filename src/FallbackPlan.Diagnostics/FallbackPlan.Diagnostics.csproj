<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!-- Domain only: this project holds the sinks, not any engine knowledge.
       It reads Domain's IRedactedValue to decide what a record may say once
       it leaves the machine (ADR-0043 section 4). -->
  <ItemGroup>
    <ProjectReference Include="..\FallbackPlan.Domain\FallbackPlan.Domain.csproj" />
  </ItemGroup>

  <!-- The ONLY project permitted to reference the concrete logging package.
       Libraries take the abstraction; the factory, the level filtering and the
       providers live here and are composed by a host (ADR-0043 section 1) —
       the same division ADR-0027 section 3 made for metrics, where the Meter
       is in-box and the exporter is somebody else's business.
       DependencyRuleTests pins this with a project-file canary. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <!-- Prebuilt package from the committed external/packages feed: parameter
         validation (ADR-0019 section 4 / ADR-0021). -->
    <PackageReference Include="Bodu.Core" />
    <!-- The ring the client log feed reads from (ADR-0043 §6). A lock-free
         Vyukov MPMC circular buffer with drop-oldest eviction — the structure
         LogRing needs, already written and already tested. A canary in
         DependencyRuleTests pins it here: it is an operational-tier dependency
         and must not drift into the format-critical closure. -->
    <PackageReference Include="Bodu.Collections.Concurrent" />
  </ItemGroup>

</Project>
