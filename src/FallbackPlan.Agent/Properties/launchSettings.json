{
  "$schema": "https://json.schemastore.org/launchsettings.json",
  "profiles": {
    "service (default locations)": {
      "commandName": "Project",
      "commandLineArgs": ""
    },
    "help": {
      "commandName": "Project",
      "commandLineArgs": "--help"
    },
    "setup (first run)": {
      "commandName": "Project",
      "commandLineArgs": "setup --archives C:\\fbp\\archives --state C:\\fbp\\state --passphrase-env FBP_PASSPHRASE --acknowledge-loss --user admin --password-env FBP_ADMIN_PASSWORD",
      "environmentVariables": {
        "FBP_PASSPHRASE": "A long local Dev passphrase 42!",
        "FBP_ADMIN_PASSWORD": "A local dev Admin password 42!"
      }
    },
    "run (foreground)": {
      "commandName": "Project",
      "commandLineArgs": "run --archives C:\\fbp\\archives --state C:\\fbp\\state --poll-seconds 10 --log-level debug"
    },
    "run --once": {
      "commandName": "Project",
      "commandLineArgs": "run --archives C:\\fbp\\archives --state C:\\fbp\\state --once --log-level debug"
    },
    "run (remote binding on)": {
      "commandName": "Project",
      "commandLineArgs": "run --archives C:\\fbp\\archives --state C:\\fbp\\state --remote-interface 127.0.0.1 --remote-port 5199 --log-level debug"
    },
    "sync (all sets, all destinations)": {
      "commandName": "Project",
      "commandLineArgs": "sync --archives C:\\fbp\\archives --state C:\\fbp\\state --log-level debug"
    },
    "verify-destination --probe": {
      "commandName": "Project",
      "commandLineArgs": "verify-destination --archives C:\\fbp\\archives --state C:\\fbp\\state --probe"
    },
    "retention (dry run)": {
      "commandName": "Project",
      "commandLineArgs": "retention --archives C:\\fbp\\archives --state C:\\fbp\\state --log-level debug"
    },
    "notices": {
      "commandName": "Project",
      "commandLineArgs": "notices --state C:\\fbp\\state"
    },
    "pairings": {
      "commandName": "Project",
      "commandLineArgs": "pairings --state C:\\fbp\\state"
    },
    "retention --apply": {
      "commandName": "Project",
      "commandLineArgs": "retention --archives C:\\fbp\\archives --state C:\\fbp\\state --passphrase-env FBP_PASSPHRASE --apply --log-level debug",
      "environmentVariables": {
        "FBP_PASSPHRASE": "A long local Dev passphrase 42!"
      }
    }
  }
}
