{
  "$schema": "https://json.schemastore.org/launchsettings.json",
  "profiles": {
    "service (default locations)": {
      "commandName": "Project",
      "commandLineArgs": ""
    },
    "help": {
      "commandName": "Project",
      "commandLineArgs": "--help"
    },
    "setup (first run)": {
      "commandName": "Project",
      "commandLineArgs": "setup --archives C:\\fbp\\archives --state C:\\fbp\\state --passphrase-env FBP_PASSPHRASE --acknowledge-loss --kit-output C:\\fbp\\kit.fbpkit --user admin --password-env FBP_ADMIN_PASSWORD",
      "environmentVariables": {
        "FBP_PASSPHRASE": "a long local dev passphrase",
        "FBP_ADMIN_PASSWORD": "a local dev admin password"
      }
    },
    "run (foreground)": {
      "commandName": "Project",
      "commandLineArgs": "run --archives C:\\fbp\\archives --state C:\\fbp\\state --poll-seconds 10 --log-level debug"
    },
    "run --once": {
      "commandName": "Project",
      "commandLineArgs": "run --archives C:\\fbp\\archives --state C:\\fbp\\state --once --log-level debug"
    },
    "run (with a passphrase, no keystore)": {
      "commandName": "Project",
      "commandLineArgs": "run --archives C:\\fbp\\archives --state C:\\fbp\\state --poll-seconds 10 --passphrase-env FBP_PASSPHRASE --log-level trace",
      "environmentVariables": { "FBP_PASSPHRASE": "a long local dev passphrase" }
    },
    "run (remote binding on)": {
      "commandName": "Project",
      "commandLineArgs": "run --archives C:\\fbp\\archives --state C:\\fbp\\state --remote-interface 127.0.0.1 --remote-port 5199 --log-level debug"
    },
    "sync (all sets, all destinations)": {
      "commandName": "Project",
      "commandLineArgs": "sync --archives C:\\fbp\\archives --state C:\\fbp\\state --passphrase-env FBP_PASSPHRASE --log-level debug",
      "environmentVariables": { "FBP_PASSPHRASE": "a long local dev passphrase" }
    },
    "verify-destination --probe": {
      "commandName": "Project",
      "commandLineArgs": "verify-destination --archives C:\\fbp\\archives --state C:\\fbp\\state --passphrase-env FBP_PASSPHRASE --probe",
      "environmentVariables": { "FBP_PASSPHRASE": "a long local dev passphrase" }
    },
    "retention (dry run)": {
      "commandName": "Project",
      "commandLineArgs": "retention --archives C:\\fbp\\archives --state C:\\fbp\\state --passphrase-env FBP_PASSPHRASE --log-level debug",
      "environmentVariables": { "FBP_PASSPHRASE": "a long local dev passphrase" }
    },
    "unlock": {
      "commandName": "Project",
      "commandLineArgs": "unlock --archives C:\\fbp\\archives --state C:\\fbp\\state --passphrase-env FBP_PASSPHRASE",
      "environmentVariables": { "FBP_PASSPHRASE": "a long local dev passphrase" }
    },
    "lock": {
      "commandName": "Project",
      "commandLineArgs": "lock --state C:\\fbp\\state"
    },
    "notices": {
      "commandName": "Project",
      "commandLineArgs": "notices --state C:\\fbp\\state"
    },
    "pairings": {
      "commandName": "Project",
      "commandLineArgs": "pairings --state C:\\fbp\\state"
    }
  }
}
