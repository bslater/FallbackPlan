<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\FallbackPlan.Storage.Abstractions\FallbackPlan.Storage.Abstractions.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- From nuget.org, pinned centrally: parameter
         validation (ADR-0019 section 4 / ADR-0021). Guard clauses are one
         vocabulary across the solution rather than per-project taste. -->
    <PackageReference Include="Bodu.Core" />
  </ItemGroup>

  <!-- The logging abstraction only: ILogger, NullLogger and the
       [LoggerMessage] source generator. Providers and sinks are the host's,
       and a canary in DependencyRuleTests keeps them there (ADR-0043). -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

  <!-- No package beyond those two: the Blob API is spoken over the
       platform's own HTTP client with a Shared Key signer of this project's
       rather than a vendor SDK, so the product's pinned package set is
       unchanged. This is one of the two assemblies allowed an HTTP client,
       and TelemetrySilenceTests names it (ADR-0093). -->

</Project>
