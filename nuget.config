<?xml version="1.0" encoding="utf-8"?>
<!--
  Restore inputs are pinned here rather than inherited from whatever the
  machine happens to have configured (NFR-SUP-002/003). <clear/> drops
  machine- and user-level sources so a rogue or misconfigured feed cannot
  inject a package; packageSourceMapping states which source may supply
  which packages, so a name squatted on one feed cannot shadow another.

  bodu-local is the vendored submodule's own package feed. It exists because
  the referenced Bodu projects pull their Bodu.CodeStyle.XmlDocumentation
  analyzer as a package from external/bodu/local-packages, not from
  nuget.org — everything else comes from nuget.org and nowhere else.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <add key="bodu-local" value="external/bodu/local-packages" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <packageSource key="bodu-local">
      <package pattern="Bodu.CodeStyle.*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
