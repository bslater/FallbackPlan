<?xml version="1.0" encoding="utf-8"?>
<!--
  Restore inputs are pinned here rather than inherited from whatever the
  machine happens to have configured (NFR-SUP-002/003). <clear/> drops
  machine- and user-level sources so a rogue or misconfigured feed cannot
  inject a package; packageSourceMapping states which source may supply
  which packages, so a name squatted on one feed cannot shadow another.

  Everything comes from nuget.org and nowhere else. The Bodu packages used
  to come from a committed local feed at external/packages, because they
  were not published; upstream publishes them now, so the feed is gone and
  the mapping below is what remains of it (ADR-0021 Amendment 1). The
  mapping survives the move because it was never about the source being
  local: it states that only one feed may answer to a name, so a package
  squatted on a second source cannot shadow a real one.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
      <package pattern="Bodu.*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
