<?xml version="1.0" encoding="utf-8"?>
<!--
  Restore inputs are pinned here rather than inherited from whatever the
  machine happens to have configured (NFR-SUP-002/003). <clear/> drops
  machine- and user-level sources so a rogue or misconfigured feed cannot
  inject a package; packageSourceMapping states which source may supply
  which packages, so a name squatted on one feed cannot shadow another.

  bodu-local is the committed local feed at external/packages. It exists
  because the Bodu packages are not published to nuget.org; committing the
  nupkgs makes a plain clone or a ZIP download restore identically
  (ADR-0021) — everything else comes from nuget.org and nowhere else.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <add key="bodu-local" value="external/packages" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <packageSource key="bodu-local">
      <package pattern="Bodu.*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
