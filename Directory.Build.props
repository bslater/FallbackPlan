<Project>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <!-- Correctness settings. Warnings-as-errors is deliberate: this is a backup
       engine, and a warning we habitually ignore is a defect we ship. -->
  <PropertyGroup>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningLevel>9999</WarningLevel>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <!-- Reproducible builds. NFR-SUP-003 requires an independent rebuild to
       produce identical artifacts. -->
  <PropertyGroup>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <DebugType>portable</DebugType>
  </PropertyGroup>

  <!-- Supply chain (NFR-SUP-002, NFR-SUP-003).

       NuGetAudit is set explicitly rather than inherited: the "warnings-as-
       errors caught a vulnerable transitive" story this repository tells
       depends on audit mode 'all', and an SDK default is not a control — a
       future SDK could narrow it to direct-only and nothing would notice.

       Lockfiles make restore reproducible, not just compilation: without one,
       what an "identical rebuild" restores depends on feed state at rebuild
       time. CI restores in locked mode so a drifted lockfile fails rather
       than silently regenerating.

       This file does not reach external/bodu — the submodule has its own
       Directory.Build.props, which stops MSBuild's upward search. That
       shielding is what makes a repo-root lockfile property safe to set. -->
  <PropertyGroup>
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditMode>all</NuGetAuditMode>
    <NuGetAuditLevel>low</NuGetAuditLevel>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>

  <!-- Global properties applied to every ProjectReference into the vendored
       Bodu submodule. Vendored code is held to its own repository's standards,
       not ours (ADR-0019) — and this must be ONE property, not three hand-
       maintained copies: the copies had already drifted, and differing
       property strings make MSBuild build the same Bodu project once per
       distinct set. The earlier NoWarn=$(NoWarn) passthrough is gone for the
       same reason — src and tests expand $(NoWarn) differently, which split
       the property sets again; with warnings unpromoted and analyzers off,
       Bodu needs no NoWarn from us. -->
  <PropertyGroup>
    <BoduProjectProperties>RunAnalyzers=false;EnforceCodeStyleInBuild=false;TreatWarningsAsErrors=false;GenerateDocumentationFile=false</BoduProjectProperties>
  </PropertyGroup>

  <PropertyGroup>
    <Product>FallbackPlan</Product>
    <RepositoryUrl>https://github.com/bslater/FallbackPlan</RepositoryUrl>
    <!-- No PackageLicenseExpression: the licence is an open decision (ADR-0001). -->
  </PropertyGroup>

</Project>
